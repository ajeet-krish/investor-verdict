# One API key server only, plus 4 public Agent IDs browser safe, there is no separate key per agent.
# Copy this template to Render dashboard env vars, never commit real values.
# ELEVENLABS_API_KEY stays server only, it mints signed URLs in deploy/server.js
ELEVENLABS_API_KEY=your_key_here
# Public agent IDs, browser safe, used by POST /api/signed-url mapping
ELEVENLABS_AGENT_ID_CTO=agent_4601m6c1gyd6e3fbs0k07r30r4k7
ELEVENLABS_AGENT_ID_TECH_BRO=agent_9801m6c1mv71e4dr3qjq5ztk524m
ELEVENLABS_AGENT_ID_INTERROGATOR=agent_5201m6c1mwkgejk83byf18qwp79j
ELEVENLABS_AGENT_ID_SYMPATHIZER=agent_4101m6c1my0bfge9cwscnp9gv2p0
# Port is set by Render, local default is 3000
PORT=3000
# Optional server Sentry DSN, leave empty to disable server reporting
SENTRY_DSN=
