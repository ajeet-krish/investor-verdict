# One API key server only, plus 4 public Agent IDs browser safe, no per agent key.
# Copy this template to Render dashboard env vars, never commit real values.
# Real IDs shared out of band via Render dashboard, not committed.
# ELEVENLABS_API_KEY stays server only, it mints signed URLs in deploy/server.js
ELEVENLABS_API_KEY=your_key_here
# Public agent IDs, browser safe, used by POST /api/signed-url mapping
ELEVENLABS_AGENT_ID_CTO=agent_cto_placeholder
ELEVENLABS_AGENT_ID_TECH_BRO=agent_tech_bro_placeholder
ELEVENLABS_AGENT_ID_INTERROGATOR=agent_interrogator_placeholder
ELEVENLABS_AGENT_ID_SYMPATHIZER=agent_sympathizer_placeholder
# Port is set by Render, local default is 3000
PORT=3000
# Optional server Sentry DSN, leave empty to disable server reporting
SENTRY_DSN=
# Same origin allowlist for browser POST routes, plus Host derived same origin
APP_ORIGIN=
# Set TRUST_PROXY to 1 when behind Render or another trusted proxy that sets
# x-forwarded-for and x-forwarded-proto, otherwise client IP uses the socket
TRUST_PROXY=
# Set SIGNED_URL_PRIVATE to 1 to require an owner verdict_room cookie or the
# gate token below before minting signed URLs, leave empty for public judging
SIGNED_URL_PRIVATE=
SIGNED_URL_GATE_TOKEN=
# Routes served by deploy/server.js (same origin, no extra deps):
# GET /health, POST /api/signed-url (agentKey body),
# POST /api/evaluate, POST /api/reset, GET or POST /api/reply-audio,
# POST /api/voice-token, /api/agent-bridge/* (connect, session,
# mode, reject, ready, disconnect, context, job, suggest),
# GET /api/elevenlabs/config, POST /api/elevenlabs/signed-url (role body).
# Panel routes load agents/server handlers with dynamic import. A local resolve
# hook serves a stub for the vendor SDKs when they are not installed, so bridge
# routes work with Node builtins only. Panel voice routes need the real
# ElevenLabs packages plus env values, else they return 502 or 503.

# Optional transcript-based founder suggestions. Keep this key server-side.
OPENAI_API_KEY=your_openai_key_here
OPENAI_COACH_MODEL=gpt-6.1-terra
OPENAI_COACH_REASONING_EFFORT=medium
